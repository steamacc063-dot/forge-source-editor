{
  "name": "forge-source-editor",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A modern desktop level editor for Source 1",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:windows": "npm run build && electron-builder --win --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "license": "MIT",
  "author": "Teodor Walter Vido",
  "repository": {
    "type": "git",
    "url": "https://github.com/steamacc063-dot/forge-source-editor.git"
  },
  "homepage": "https://github.com/steamacc063-dot/forge-source-editor#readme",
  "bugs": {
    "url": "https://github.com/steamacc063-dot/forge-source-editor/issues"
  },
  "keywords": [
    "source-engine",
    "map-editor",
    "level-editor",
    "vmf",
    "hammer",
    "electron",
    "threejs",
    "typescript"
  ],
  "build": {
    "appId": "io.github.forge-source-editor",
    "productName": "Forge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "THIRD_PARTY.md",
      "licenses/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "artifactName": "Forge-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development",
      "maintainer": "Teodor Walter Vido <112107182+baiehclaca@users.noreply.github.com>"
    }
  }
}
