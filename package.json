{
  "name": "forge-source-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modern desktop level editor for Source 1",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "package:mac": "npm run build && electron-packager . Forge --platform=darwin --arch=arm64 --out=release --overwrite --ignore='^/(src|tests|examples|node_modules|release|docs|.git|.github)'",
    "package:windows": "npm run build && electron-packager . Forge --platform=win32 --arch=x64 --out=release --overwrite --ignore='^/(src|tests|examples|node_modules|release|docs|.git|.github)'"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "license": "MIT",
  "author": "Teodor Walter Vido",
  "repository": {
    "type": "git",
    "url": "https://github.com/baiehclaca/forge-source-editor.git"
  },
  "homepage": "https://github.com/baiehclaca/forge-source-editor#readme",
  "bugs": {
    "url": "https://github.com/baiehclaca/forge-source-editor/issues"
  },
  "keywords": [
    "source-engine",
    "map-editor",
    "level-editor",
    "vmf",
    "hammer",
    "electron",
    "threejs",
    "typescript"
  ]
}
